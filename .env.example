# Copy this file to `.env` and fill in the real value.
#
# `.env` is gitignored and must NEVER be committed. It is a LOCAL ADMIN TOOL
# only — it is not used by the running app, and it never goes into
# .streamlit/secrets.toml or Streamlit Community Cloud.
#
# Used by: scripts/seed_db.py, scripts/apply_migrations.py,
#          scripts/export_questions.py

# Supabase Postgres connection string.
# Get it from: Supabase dashboard -> Connect (green button, top bar)
#              -> "Direct" tab -> Session pooler
# Then replace [YOUR-PASSWORD] with your database password.
#
# Use the SESSION pooler (port 5432), not the transaction pooler (port 6543):
# psycopg3 prepares statements after a few executions, which the transaction
# pooler does not support.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxxxxxx:[YOUR-PASSWORD]@aws-1-us-west-2.pooler.supabase.com:5432/postgres
