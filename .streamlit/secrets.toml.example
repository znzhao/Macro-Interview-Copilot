# Copy this file to secrets.toml and fill in real values.
#
# secrets.toml is gitignored and must NEVER be committed.
# On Streamlit Community Cloud you do not upload this file at all — you paste
# its contents into the app's Settings -> Secrets box instead.
# See docs/DEPLOYMENT.md.

[supabase]
url = "https://xxxxxxxxxxxxxxxx.supabase.co"

# The PUBLIC key. Supabase has two formats depending on project age; either
# works with supabase-py, and both go in this same field:
#   new     -> sb_publishable_xxxxxxxx
#   legacy  -> eyJhbGciOi...   (a JWT with role "anon")
# Safe in a browser-facing app because Row Level Security constrains it.
#
# NEVER put the secret key here (sb_secret_... or the service_role JWT) —
# it bypasses all RLS and can read every user's data.
anon_key = "sb_publishable_xxxxxxxx"

[app]
environment = "development"          # "development" | "production"

# This app's own public URL. Must exactly match a Redirect URL configured in
# Supabase (Authentication -> URL Configuration), or sign-in will not return here.
#   local:      http://localhost:8501
#   deployed:   https://<your-app>.streamlit.app
app_url = "http://localhost:8501"

# Bootstrap only. Real admin rights live in the profiles.is_admin column.
admin_emails = ["you@example.com"]
